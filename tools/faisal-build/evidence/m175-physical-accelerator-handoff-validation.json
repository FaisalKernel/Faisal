    "sources": [
      {
        "url": "https://docs.kernel.org/core-api/dma-api-howto.html",
        "conclusion": "Physical DMA qualification must use the Linux DMA API model, appropriate DMA masks, mapping/synchronization/unmap checks, and observed fault handling; device count alone is insufficient."
      },
      {
        "url": "https://docs.kernel.org/gpu/drm-mm.html",
        "conclusion": "Dedicated device memory is managed through upstream DRM GEM/TTM paths; VRAM qualification must measure the actual device-memory domain and its allocation/reclamation/accounting behavior."
      },
      {
        "url": "https://docs.kernel.org/driver-api/vfio.html",
        "conclusion": "IOMMU groups are the minimum isolation granularity for secure direct device access; group membership, topology, DMA ownership, IOMMU translation, and reset are qualification requirements."
      }
    ]
